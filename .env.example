# Workflow People — Environment Variables
# Copy this file to .env and fill in the values.

# ── Edition & key mode ───────────────────────────────────────────────────────

# EDITION selects where workspace data lives and presets the billing/key/data
# knobs below (each can still be overridden individually):
#   hosted     — SaaS: workspaces in Supabase; users buy credits. (default)
#   enterprise — multi-user self-host: Postgres; the admin fronts the keys.
#   local      — single-user desktop: local `.wfp` file; user's own keys (BYO).
# "standard" is accepted as an alias for "hosted".
EDITION=hosted

# KEY_MODE (env: BILLING_MODE) — who fronts the LLM/Classifier keys:
#   credits    — WFP fronts keys; server-key users are credit-gated + rate-limited.
#   admin_pays — the admin fronts the key for everyone; no per-user gate.
#   none       — single-user BYO; no billing, no gate. ("byo" is an alias)
# Unset → derived from EDITION (hosted→credits, enterprise→admin_pays, local→none).
BILLING_MODE=

# KeyStore backend: "postgres" (admin_users.encrypted_secrets) or "file" (local
# encrypted file under data/{INSTANCE}/keystore/). "file" stores the same
# AES-GCM-encrypted blob (APP_SECRET) so keys never leave the machine.
# Unset → derived from EDITION (local→file, otherwise postgres).
KEYSTORE=

# Base directory for all app-written files (data/, logs/, keystore/). When unset,
# defaults by EDITION:
#   hosted → the process working directory (as before)
#   enterprise/local → a per-user OS-standard location:
#     Windows: %APPDATA%\WorkflowPeople
#     macOS:   ~/Library/Application Support/WorkflowPeople
#     Linux:   $XDG_CONFIG_HOME/workflowpeople (or ~/.config/workflowpeople)
# Set explicitly to override (e.g. a mounted volume in Docker).
DATA_DIR=

# Instance identifier (namespaces the temp/data dirs)
INSTANCE=prod

# ── LLM / Classifier server keys ─────────────────────────────────────────────

# Abstract operator keys. CLASSIFIER_* powers the System One classifier (Jev);
# LLM_API_* is the server-side default LLM. The provider-specific keys below
# remain as fallback when these are unset.
CLASSIFIER_PROVIDER=openrouter
CLASSIFIER_KEY=
LLM_API_PROVIDER=openrouter
LLM_API_KEY=

# Provider-specific server keys (proxied for users who don't bring their own).
# The chat LLM (System Two):
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# The classifier (System One) — OpenRouter decisions endpoint. CLASSIFIER_KEY
# above is the abstract alias; either works.
OPENROUTER_JEV_API_KEY=sk-or-v1-...

# OpenRouter app identification (HTTP-Referer / X-OpenRouter-Title). Title falls
# back to SERVER below when unset.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=

# ── Core secret ──────────────────────────────────────────────────────────────

# Cookie signing + API key encryption secret (random string, keep secret)
APP_SECRET=generate-a-random-string-here

# ── Supabase (admin_users + llm_usage storage) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# Supabase (PostgREST) request timeout and retry count.
SUPABASE_TIMEOUT_MS=15000
SUPABASE_MAX_RETRIES=3

# ── Authentication ───────────────────────────────────────────────────────────

# AUTH — how users sign in. Preset by EDITION (local→none, enterprise→password,
# hosted→google); set explicitly to override:
#   none     — no login (single-user local)
#   password — email + password (enterprise self-host; no email/Google needed)
#   google   — Google OAuth + magic link (hosted)
AUTH=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link email via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Inbound email (Resend webhook) — signing secret from the Resend dashboard.
# Leave unset to reject all inbound webhooks.
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=in.workflowpeople.com

# Destination inbox for contact-form + beta-request/demo emails. Both forms
# fail closed (return "not configured") when unset — there is no default.
CONTACT_TO_EMAIL=
BETA_REQUEST_TO_EMAIL=

# Inbound email agent. Set to "false" to disable the headless shadow agent.
EMAIL_AGENT_ENABLED=true

# Admin user email — auto-created on first startup if not exists
ADMIN_USER=you@example.com

# Initial admin password for AUTH=password. Hashed into admin_users.password_hash
# on startup only if not already set. Rotate later via scripts/reset-password.ts.
ADMIN_PASSWORD=

# Failed login attempts per email+IP per hour (AUTH=password). Default: 10.
AUTH_LOGIN_RATE_LIMIT_PER_HOUR=10

# ── Test / dev auth bypass ──────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY. When set, every request is signed in as this email
# without OAuth or magic-link. The account is auto-created on startup if
# missing. Leave BLANK (or remove) to disable. There is NO default value.
# NEVER set this in production — the runtime blocks it when NODE_ENV=production.
TEST_USER=
DEV_AUTH_BYPASS_EMAIL=
DEV_AUTH_BYPASS=

# ── Billing / credits ────────────────────────────────────────────────────────

# Per-call upcharge on server-key usage (fraction). Billed = token cost ×
# (1 + CREDIT_MARGIN). 0 = no upcharge.
CREDIT_MARGIN=0

# Beta credit hard-block for server-key users. Set to "true" to disable the
# guard (operator escape hatch). Default: off (guard enforced).
DISABLE_CREDIT_GUARD=false

# Per-user LLM usage tracking to Supabase (llm_usage table) — powers the
# /app/account usage panel and the credit allowance metering.
# Enabled by default. Set to "false" for pure self-hosted BYO-key deployments.
TRACK_LLM_USAGE=true

# Rate limiting: max LLM calls per hour for server-key users (default: 60)
LLM_RATE_LIMIT_PER_HOUR=60

# ── QuickBooks ───────────────────────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Base URL for the QBO OAuth redirect (falls back to the request host when unset)
QBO_REDIRECT_BASE=
# Disable the live QuickBooks Online integration entirely (skills + MCP tools).
# Set "true" when a deployment uses the internal file-based wfp.qbo ledger.
DISABLE_LIVE_QBO=false
# QBO connections are scoped per workspace (client), not per user: each client
# keeps its own QBO and the OAuth tokens persist encrypted in the host's secrets
# vault (admin_users.encrypted_secrets, AES-256-GCM with APP_SECRET). Switching
# workspaces can never surface another client's QuickBooks.

# ── MCP ──────────────────────────────────────────────────────────────────────
# Base URL for MCP OAuth redirects (falls back to the request host when unset)
MCP_REDIRECT_BASE=

# ── Orchestrator ─────────────────────────────────────────────────────────────
# Chat orchestrator version. Only "vers_8" is supported today (the default).
ORCHESTRATOR=vers_8

# ── Legacy LLM defaults ──────────────────────────────────────────────────────
# Prefer per-user provider/model config (Settings). These remain as fallbacks.
LLM_PROVIDER=
LLM_MODEL=
TOGETHER_MODEL=
TOGETHER_VISION_MODEL=

# ── UI labels (user-facing; do not rename internal identifiers) ──────────────
# SERVER    → firm/company name shown in the header
# WORKSPACE → the word shown for a workspace (e.g. "Client")
SERVER=Workflow People
WORKSPACE=Workspace

# ── Runtime / persistence ────────────────────────────────────────────────────
# Server port (default: 3000)
PORT=3000

# Workspace auto-save debounce (ms) before a mutation is flushed to Supabase.
AUTOSAVE_DELAY_MS=1500

# Idle workspace sessions are closed after this long (ms); swept at this interval.
IDLE_TIMEOUT_MS=900000
SWEEP_INTERVAL_MS=60000

# SSE live-update stream reconnect interval (ms) advertised to the browser.
SSE_RETRY_MS=3000

# Report date range defaults
DEFAULT_REPORT_START_DATE=2026-01-01
DEFAULT_REPORT_END_DATE=2026-12-31

# ── Feature flags ────────────────────────────────────────────────────────────

# Enable page view tracking to Supabase (site_visits table)
TRACK_VISITS=false

# Comma-separated list of skill names to hide from the chat and Firm Skills
# list (e.g. "qbo-analysis,plan"). Leave empty to show all skills.
DISABLED_SKILLS=
