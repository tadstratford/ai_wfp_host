{
  "name": "workflowpeople",
  "scripts": {
    "dev": "bun run --hot src/server/index.tsx",
    "dev:local": "EDITION=local bun run --hot src/server/index.tsx",
    "dev:enterprise": "EDITION=enterprise bun run --hot src/server/index.tsx",
    "dev:start": "bun run --hot src/server/index.tsx",
    "start": "bun src/server/index.tsx",
    "dev:nolog": "bun run --hot src/server/index.tsx",
    "typecheck": "bun tsc --noEmit",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/css/tailwind.css --minify",
    "build": "bun run build:css && bun run build:exe",
    "build:exe": "bun build --compile ./src/server/index.tsx --outfile workflowpeople"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/uuid": "^10.0.0",
    "compromise": "^14.17.0",
    "hono": "^3.12.6",
    "marked": "^16.0.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
