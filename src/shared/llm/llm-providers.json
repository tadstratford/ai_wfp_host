        "temperature": "{{temperature}}",
        "max_tokens": "{{maxTokens}}",
        "response_format": "{{responseFormat}}"
      },
      "responseMapping": {
        "content": "choices[0].message.content",
        "usage": "usage"
      }
    },
    "anthropic": {
      "endpoint": "/messages",
      "requestBody": {
        "model": "{{model}}",
        "messages": "{{messages}}",
        "max_tokens": "{{maxTokens}}",
